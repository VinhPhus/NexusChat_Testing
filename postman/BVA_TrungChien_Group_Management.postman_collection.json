  "item": [
    {
      "name": "BVA - Quan tri nhom chat",
      "description": "Chạy tuần tự các request trong Collection Runner. Các case BVA chỉ thay đổi một biến mỗi lần; các biến còn lại giữ Nom.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const caseNo = Number(pm.variables.get('caseNo'));",
              "const groupNameLength = Number(pm.variables.get('groupNameLength'));",
              "const memberCount = Number(pm.variables.get('memberCount'));",
              "const deputyCount = Number(pm.variables.get('deputyCount'));",
              "const token = pm.variables.get('bearerToken');",
              "let allMemberIds;",
              "",
              "try {",
              "  allMemberIds = JSON.parse(pm.variables.get('memberIds') || '[]');",
              "} catch (error) {",
              "  throw new Error('Collection variable memberIds phải là mảng JSON hợp lệ.');",
              "}",
              "",
              "if (!token) throw new Error('Hãy cấu hình Collection variable bearerToken trước khi chạy.');",
              "if (!Array.isArray(allMemberIds)) throw new Error('memberIds phải là một mảng JSON.');",
              "if (allMemberIds.length < memberCount - 1) {",
              "  throw new Error(`Case ${caseNo} cần ${memberCount - 1} ID thành viên ngoài trưởng nhóm, nhưng memberIds chỉ có ${allMemberIds.length}.`);",
              "}",
              "",
              "const selectedIds = allMemberIds.slice(0, memberCount - 1);",
              "if (new Set(selectedIds).size !== selectedIds.length) throw new Error('memberIds không được chứa ID trùng lặp.');",
              "if (selectedIds.some((id) => typeof id !== 'string' || !/^[a-f\\d]{24}$/i.test(id))) {",
              "  throw new Error('Mỗi giá trị trong memberIds được sử dụng phải là MongoDB ObjectId gồm 24 ký tự hex.');",
              "}",
              "if (deputyCount > selectedIds.length) throw new Error(`Case ${caseNo} cần ${deputyCount} thành viên để gán phó nhóm.`);",
              "",
              "const groupName = `G${String(caseNo).padStart(2, '0')}${'x'.repeat(groupNameLength - 3)}`;",
              "pm.variables.set('groupName', groupName);",
              "pm.variables.set('memberIdsForCase', JSON.stringify(selectedIds));",
              "console.log(`Case ${caseNo}: name length=${groupName.length}, total members=${memberCount}, deputies=${deputyCount}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const caseNo = Number(pm.variables.get('caseNo'));",
              "const memberCount = Number(pm.variables.get('memberCount'));",
              "const deputyCount = Number(pm.variables.get('deputyCount'));",
              "const selectedIds = JSON.parse(pm.variables.get('memberIdsForCase') || '[]');",
              "const baseUrl = pm.variables.get('baseUrl');",
              "const token = pm.variables.get('bearerToken');",
              "",
              "pm.test(`Case ${caseNo}: tạo nhóm trả HTTP 201`, () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) return;",
              "",
              "const payload = pm.response.json();",
              "const conversation = payload.conversation;",
              "pm.test(`Case ${caseNo}: có dữ liệu nhóm trả về`, () => pm.expect(conversation).to.be.an('object')) ;",
              "if (!conversation || !conversation._id) return;",
              "",
              "pm.test(`Case ${caseNo}: tên nhóm đúng độ dài`, () => pm.expect(conversation.group.name).to.have.length(Number(pm.variables.get('groupNameLength'))));",
              "pm.test(`Case ${caseNo}: số thành viên đúng`, () => pm.expect(conversation.participants).to.have.length(memberCount));",
              "pm.collectionVariables.set('lastCreatedGroupId', conversation._id);",
              "",
              "const expectedDeputyIds = selectedIds.slice(0, deputyCount);",
              "if (expectedDeputyIds.length === 0) {",
              "  pm.test(`Case ${caseNo}: số phó nhóm bằng ${deputyCount}`, () => pm.expect(conversation.participants.filter((participant) => participant.role === 'deputy')).to.have.length(deputyCount));",
              "  return;",
              "}",
              "",
              "let nextIndex = 0;",
              "let lastParticipants = conversation.participants;",
              "const assignNextDeputy = () => {",
              "  if (nextIndex >= expectedDeputyIds.length) {",
              "    pm.test(`Case ${caseNo}: số phó nhóm bằng ${deputyCount}`, () => pm.expect(lastParticipants.filter((participant) => participant.role === 'deputy')).to.have.length(deputyCount));",
              "    return;",
              "  }",
              "",
              "  const memberId = expectedDeputyIds[nextIndex++];",
              "  pm.sendRequest({",
              "    url: `${baseUrl}/api/conversations/${conversation._id}/role`,",
              "    method: 'PATCH',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      Authorization: `Bearer ${token}`",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ memberId, role: 'deputy' }) }",
              "  }, (error, response) => {",
              "    pm.test(`Case ${caseNo}: gán phó nhóm ${nextIndex} thành công`, () => {",
              "      pm.expect(error, error ? error.message : 'Không có lỗi kết nối').to.equal(null);",
              "      pm.expect(response.code).to.equal(200);",
              "    });",
              "    if (error || response.code !== 200) return;",
              "",
              "    const rolePayload = response.json();",
              "    lastParticipants = rolePayload.participants || [];",
              "    const promotedMember = lastParticipants.find((participant) => String(participant._id) === memberId);",
              "    pm.test(`Case ${caseNo}: thành viên được gán có role deputy`, () => pm.expect(promotedMember && promotedMember.role).to.equal('deputy'));",
              "    assignNextDeputy();",
              "  });",
              "};",
              "",
              "assignNextDeputy();"
            ]
          }
        }
      ],
