{
	"info": {
		"_postman_id": "bva-tv2-chat-upload-collection",
		"name": "BVA Test Suite - Thành Viên 2 (Gửi Tin Nhắn & Tệp Đính Kèm)",
		"description": "Bộ kịch bản kiểm thử giá trị biên tự động hóa dành riêng cho Thành viên 2: Gửi tin nhắn & Tệp đính kèm (Chat & Upload). Tuân thủ nghiêm ngặt công thức Standard BVA (4n + 1 = 9 cases) và mở rộng Robustness BVA.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
