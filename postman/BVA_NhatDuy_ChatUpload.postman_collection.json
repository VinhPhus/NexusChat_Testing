	"item": [
		{
			"name": "0. Xác thực & Đăng nhập (Setup)",
			"item": [
				{
					"name": "0.1 Đăng nhập lấy Bearer Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Đăng nhập thành công - HTTP 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"var token = jsonData.accessToken || jsonData.token || (jsonData.user && jsonData.user.token);",
									"if (token) {",
									"    pm.collectionVariables.set(\"accessToken\", token);",
									"    pm.environment.set(\"accessToken\", token);",
									"    console.log(\"Saved accessToken:\", token);",
									"}",
									"",
									"// Tự động tìm friendId thật từ danh sách bạn bè",
									"var baseUrl = pm.collectionVariables.get(\"baseUrl\") || \"http://localhost:5002\";",
									"if (token) {",
									"    pm.sendRequest({",
									"        url: baseUrl + \"/api/friends\",",
									"        method: \"GET\",",
									"        header: { \"Authorization\": \"Bearer \" + token }",
									"    }, function (err, res) {",
									"        if (!err && res.code === 200) {",
									"            var fData = res.json();",
									"            var friends = fData.friends || fData;",
									"            if (Array.isArray(friends) && friends.length > 0) {",
									"                var validId = friends[0]._id || friends[0].id;",
									"                pm.collectionVariables.set(\"receiverId\", validId);",
									"                pm.environment.set(\"receiverId\", validId);",
									"                console.log(\"Đã tự động gán receiverId là bạn bè thật:\", validId);",
									"            }",
									"        }",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"duy123\",\n  \"password\": \"Duy3101\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/signin",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"signin"
							]
						}
					}
				},
				{
					"name": "0.2 Lấy Danh Sách Bạn Bè (Auto-detect receiverId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Lấy danh sách bạn bè thành công - HTTP 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"var friends = jsonData.friends || jsonData;",
									"if (Array.isArray(friends) && friends.length > 0) {",
									"    var validId = friends[0]._id || friends[0].id;",
									"    pm.collectionVariables.set(\"receiverId\", validId);",
									"    pm.environment.set(\"receiverId\", validId);",
									"    console.log(\"Đã lưu friendId vào receiverId:\", validId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/friends",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"friends"
							]
						}
					}
				}
			]
		},
