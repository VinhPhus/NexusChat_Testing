{
  "info": {
    "_postman_id": "f24a0134-4201-4f2c-9a4c-9d51f9583615",
    "name": "NexusChat - Standard BVA - Poll Creation",
    "description": "Standard BVA for poll creation: 9 cases (4n+1, n=2). Run the request with 9 iterations in Collection Runner. Set baseUrl, bearerToken, and conversationId before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Create poll - Standard BVA (9 cases)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cases = [",
              "  { questionLength: 5, optionsCount: 4, label: 'Case 1 - question Min' },",
              "  { questionLength: 6, optionsCount: 4, label: 'Case 2 - question Min+' },",
              "  { questionLength: 40, optionsCount: 4, label: 'Case 3 - Nominal' },",
              "  { questionLength: 99, optionsCount: 4, label: 'Case 4 - question Max-' },",
              "  { questionLength: 100, optionsCount: 4, label: 'Case 5 - question Max' },",
              "  { questionLength: 40, optionsCount: 2, label: 'Case 6 - options Min' },",
              "  { questionLength: 40, optionsCount: 3, label: 'Case 7 - options Min+' },",
              "  { questionLength: 40, optionsCount: 9, label: 'Case 8 - options Max-' },",
              "  { questionLength: 40, optionsCount: 10, label: 'Case 9 - options Max' }",
              "];",
              "",
              "const testCase = cases[pm.info.iteration % cases.length];",
              "const poll = {",
              "  question: 'Q'.repeat(testCase.questionLength),",
              "  options: Array.from({ length: testCase.optionsCount }, (_, index) => ({",
              "    text: `Option ${index + 1}`",
              "  })),",
              "  allowMultiple: false",
              "};",
              "",
              "pm.variables.set('bvaCaseLabel', testCase.label);",
              "pm.variables.set('bvaQuestionLength', String(testCase.questionLength));",
              "pm.variables.set('bvaOptionsCount', String(testCase.optionsCount));",
              "pm.variables.set('pollPayload', JSON.stringify({",
              "  conversationId: pm.collectionVariables.get('conversationId'),",
              "  content: '',",
              "  poll",
              "}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const label = pm.variables.get('bvaCaseLabel');",
              "const questionLength = Number(pm.variables.get('bvaQuestionLength'));",
              "const optionsCount = Number(pm.variables.get('bvaOptionsCount'));",
              "",
              "pm.test(`${label}: API creates the poll`, function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "  const response = pm.response.json();",
              "  const poll = response.message && response.message.poll;",
              "",
              "  pm.test(`${label}: returned question length is ${questionLength}`, function () {",
              "    pm.expect(poll).to.be.an('object');",
              "    pm.expect(poll.question).to.have.lengthOf(questionLength);",
              "  });",
              "",
              "  pm.test(`${label}: returned option count is ${optionsCount}`, function () {",
              "    pm.expect(poll.options).to.be.an('array').with.lengthOf(optionsCount);",
              "    poll.options.forEach(function (option) {",
              "      pm.expect(option.text).to.be.a('string').and.not.empty;",
              "    });",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{pollPayload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/messages/group",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages",
            "group"
          ]
        },
        "description": "One request body is generated per iteration. Run this request with 9 iterations in Postman Collection Runner to execute all Standard BVA cases."
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "bearerToken",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    }
  ]
}
