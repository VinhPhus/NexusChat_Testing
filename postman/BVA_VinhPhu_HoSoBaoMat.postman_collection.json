		{
			"name": "2. Robustness BVA (5 Cases - Min-1 & Max+1)",
			"description": "Kiểm thử các giá trị ngoài biên phạm vi để kiểm tra cơ chế bắt lỗi và bảo vệ hệ thống.",
			"item": [
				{
					"name": "TC_ROB_01: display_name dưới biên Min-1 (1 ký tự)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"displayName\": \"A\",\n  \"bio\": \"Hello, I am using NexusChat !!\",\n  \"lock_timeout\": 15\n}"
						},
