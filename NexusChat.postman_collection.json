		"item": [
			{
				"name": "Auth",
				"item": [
					{
						"name": "Signup",
						"request": {
							"method": "POST",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": {
								"mode": "raw",
								"raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
							},
							"url": {
								"raw": "{{baseUrl}}/api/auth/signup",
								"host": [
									"{{baseUrl}}"
								],
								"path": [
									"api",
									"auth",
									"signup"
								]
							}
						}
					},
					{
						"name": "Signin",
