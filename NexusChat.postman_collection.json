		"auth": {
			"type": "bearer",
			"bearer": [
				{
					"key": "token",
					"value": "{{bearerToken}}",
					"type": "string"
				}
			]
		},
		"variable": [
			{
				"key": "baseUrl",
				"value": "http://localhost:5002"
			},
			{
				"key": "bearerToken",
				"value": ""
			}
		]
